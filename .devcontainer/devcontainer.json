{
  "name": "Fullstack App (C# & Angular)",
  "dockerComposeFile": "../compose.yaml",
  "service": "api",
  "workspaceFolder": "/workspaces/fullstack-app",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ckolkman.vscode-postgres",
        "Angular.ng-template",
