root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
indent_size = 4
# CSharpier reads this as its print width.
max_line_length = 100

# EF writes these; marking them as what they are rather than restyling them.
# The leading **/ matters — a bare Migrations/*.cs only matches at the repo root.
[**/Migrations/*.cs]
generated_code = true

# ============================================================
# C# style. Severities are enforced on build via
# EnforceCodeStyleInBuild in Directory.Build.props.
# ============================================================
[*.cs]

# --- what this codebase already does ---
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = false
csharp_style_prefer_conditional_expression_over_return = false
csharp_style_prefer_conditional_expression_over_assignment = false
csharp_style_expression_bodied_methods = when_on_single_line
csharp_style_expression_bodied_properties = true
csharp_style_expression_bodied_accessors = true
csharp_style_prefer_primary_constructors = false
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning

# --- modern C# worth adopting ---
dotnet_style_collection_initializer = true:warning
dotnet_style_prefer_collection_expression = true:warning
dotnet_style_object_initializer = true:warning
dotnet_style_null_propagation = true:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_readonly_field = true:warning
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_prefer_pattern_matching = true:warning
csharp_prefer_simple_using_statement = true:warning
csharp_using_directive_placement = outside_namespace:warning

# One rule ID for every formatting option, several disagreeing with CSharpier.
dotnet_diagnostic.IDE0055.severity = none

# var stays a judgement call: the distinction every style guide turns on
# (transient pass-through) has no .editorconfig setting, so enforcing either
# extreme encodes a rule nobody actually recommends. See the backlog.
dotnet_diagnostic.IDE0007.severity = none
dotnet_diagnostic.IDE0008.severity = none
